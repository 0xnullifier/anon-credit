{
  "name": "anon-credit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "./check.sh",
    "dashboard:dev": "pnpm --filter @anon-credit/dashboard dev",
    "app:dev": "pnpm --filter @anon-credit/app dev:stack",
    "app:build": "pnpm --filter @anon-credit/app build",
    "app:check": "pnpm --filter @anon-credit/app typecheck && pnpm --filter @anon-credit/app test",
    "example:e2e": "pnpm --filter @anon-credit/example-e2e start",
    "test:integration": "tooling/dev/integration.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
