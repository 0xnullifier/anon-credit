# ProveKit toolchain pins. The scripts in this directory read this file.
# Change these values only together with new artifacts and a new manifest.

# ProveKit main at this commit. It has hiding witness commitments (prepare --witness-mode zk,
# the default). The published @worldcoin/provekit 0.1.1 SDK predates this and is not hiding.
PROVEKIT_REPO=https://github.com/worldfnd/provekit
PROVEKIT_REV=201b7b639f5dd5632c01561fcb2a96c2fc8851f3
PROVEKIT_RUST_TOOLCHAIN=nightly-2026-03-04

# Noir frontend that the pinned ProveKit commit links (Cargo.toml: noir rev v1.0.0-beta.26).
NOIR_VERSION=1.0.0-beta.26
NOIR_COMMIT=40d6574f851d926f93e0c3a271bac3e6e82ac905
NOIR_NARGO_URL=https://github.com/noir-lang/noir/releases/download/v1.0.0-beta.26/nargo-aarch64-apple-darwin.tar.gz
NOIR_NARGO_SHA256=2b8a938a0eae411d0105133eb1eb97b0b1f1942037b2f42c9fac72456f5e9b32

# wasm-bindgen-cli must equal the wasm-bindgen crate version in ProveKit's Cargo.lock.
WASM_BINDGEN_VERSION=0.2.113

# prepare options for every circuit.
PROVEKIT_HASH=skyscraper
PROVEKIT_WITNESS_MODE=zk

# Local directories. Override them in the environment.
PROVEKIT_SRC=${PROVEKIT_SRC:-$HOME/dev/provekit-src}
PROVEKIT_WASM_SRC=${PROVEKIT_WASM_SRC:-$HOME/dev/provekit-wasm-build}
NOIR_HOME=${NOIR_HOME:-$HOME/dev/noir-$NOIR_VERSION}
PROVEKIT_CLI=${PROVEKIT_CLI:-$PROVEKIT_SRC/target/release/provekit-cli}
NARGO=${NARGO:-$NOIR_HOME/bin/nargo}
