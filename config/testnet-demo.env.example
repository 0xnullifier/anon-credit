# Environment for the Sepolia testnet demo profile.
#
# Copy to config/testnet-demo.env (git ignores it) and fill in the values. Do not commit real
# values. Empty values count as not set. tooling/dev/run-services.sh reads this file; for the
# example run, load it in the shell: set -a; source config/testnet-demo.env; set +a
# RUNBOOK.md has the full operator sequence.

# --- Shared ---------------------------------------------------------------
# Path of the deployment TOML file. tooling/deploy/deploy-sepolia.sh writes it.
DEPLOYMENT_CONFIG=config/deployment.testnet.toml
# Epoch length in seconds. Testnet: 30. Production: 900. Must match the deployment file.
EPOCH_SECONDS=30
# Log filter for the Rust services.
RUST_LOG=info

# --- Issuer ---------------------------------------------------------------
# Listen address. Put an HTTPS reverse proxy in front for public access. Use 127.0.0.1:8080
# if the proxy is on the same host.
ISSUER_BIND=127.0.0.1:8080
# SQLite database (WAL, synchronous FULL). Keep it on a durable disk and back it up.
ISSUER_DB_PATH=data/issuer.db
# Sepolia RPC for payment indexing and root publication. Can contain an API key: secret.
# The RPC must support the "finalized" block tag. Without it, issuance waits.
SEPOLIA_RPC_URL=
# Private key of the root publisher (issuer_address). Secret. Never commit it.
# Without it, the issuer records roots but does not send postRoot transactions.
ISSUER_PRIVATE_KEY=
# Optional. If set, they must equal sale_address and root_registry_address of the deployment.
SALE_ADDRESS=
ROOT_REGISTRY_ADDRESS=
# First block of the sale indexer: the CreditSale deployment block. deploy-sepolia.sh prints it.
ISSUER_START_BLOCK=0
# Seconds between indexer passes and between publisher passes.
ISSUER_INDEX_POLL_SECONDS=12
ISSUER_PUBLISH_POLL_SECONDS=5
# Largest block range of one eth_getLogs request. Lower it if the RPC limits ranges.
ISSUER_LOG_CHUNK_BLOCKS=1000

# --- Contract deployment (tooling/deploy/deploy-sepolia.sh) ----------------
# Public address of ISSUER_PRIVATE_KEY. CreditSale and RootRegistry trust only this address.
# Empty: the helper uses the address of ISSUER_PRIVATE_KEY.
ISSUER_ADDRESS=
# Price of one batch in wei. Testnet default: 100000000000000.
BATCH_PRICE_WEI=100000000000000
# Optional deployer key. Secret. Empty: ISSUER_PRIVATE_KEY sends the deploy transactions.
DEPLOYER_PRIVATE_KEY=
# Optional. Secret. If set, the helper verifies both contracts on Etherscan.
ETHERSCAN_API_KEY=

# --- Gateway --------------------------------------------------------------
# Public API listen address. Put an HTTPS reverse proxy in front for public access.
GATEWAY_PUBLIC_BIND=127.0.0.1:8081
# Admin API listen address. Keep it on loopback or a private network.
GATEWAY_ADMIN_BIND=127.0.0.1:8082
GATEWAY_DATABASE_PATH=data/gateway.db
# Upstream Sepolia RPC for paid JSON-RPC reads. Secret if it contains an API key.
GATEWAY_UPSTREAM_RPC_URL=
# Sepolia RPC to read finalized roots from RootRegistry. Empty: use SEPOLIA_RPC_URL.
GATEWAY_ROOT_RPC_URL=
# Root source: contract (RootRegistry at the finalized tag) or issuer-http (the issuer
# GET /v1/roots, only finalized records; it trusts the issuer: local runs only).
GATEWAY_ROOT_SOURCE=contract
# Issuer base URL for GATEWAY_ROOT_SOURCE=issuer-http. Not used with contract.
GATEWAY_ROOT_ISSUER_URL=
# Bearer token for the admin API and the dashboard. Secret. Make it with `openssl rand -hex 32`.
GATEWAY_ADMIN_TOKEN=
# Demo profile only: show the observed source IP in the dashboard event stream.
DEMO_IP_LOGGING=true
# Trusted reverse proxy addresses, comma separated. Empty: use only the socket peer address.
# Only these peers can set the observed IP with GATEWAY_FORWARDED_HEADER. With Caddy or nginx
# on the same host: 127.0.0.1 (the proxy connects from loopback). RUNBOOK.md step 5.
GATEWAY_TRUSTED_PROXY_ADDRS=
GATEWAY_FORWARDED_HEADER=x-forwarded-for
# ProveKit verifier sidecar (`anon-credit-prover serve`). Keep it on loopback.
GATEWAY_VERIFIER_URL=http://127.0.0.1:8083
# Expected upstream eth_chainId. Empty: the deployment payment_chain_id (Sepolia).
GATEWAY_UPSTREAM_CHAIN_ID=
# Time between root reads from RootRegistry (finalized block tag).
GATEWAY_ROOT_POLL_SECONDS=10
# Prototype limits (implementation.md section 12). The gateway publishes them in /v1/config.
GATEWAY_OPEN_BODY_LIMIT_BYTES=16777216
GATEWAY_SPEND_BODY_LIMIT_BYTES=65536
GATEWAY_UPSTREAM_RESPONSE_LIMIT_BYTES=1048576
GATEWAY_UPSTREAM_TIMEOUT_MS=15000
GATEWAY_PROOF_CONCURRENCY=2
GATEWAY_PROOF_QUEUE_DEPTH=8
# Origins allowed to call the public API and the demo peer probe: the e2e page (5173) and the
# dashboard (5174), with both host names.
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- End-to-end example and browser ---------------------------------------
# Sepolia RPC to read the Nox specifier contract. Separate role from payment indexing.
NOX_BOOTSTRAP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Test payer private key for the example purchase. Secret. Testnet funds only.
E2E_PAYER_KEY=
# Public HTTPS URLs of the deployed services. The example refuses localhost and private
# addresses: the Nox exit cannot reach them.
E2E_ISSUER_URL=
E2E_GATEWAY_URL=
# Sepolia RPC of the payer for the purchase and the funding check. Empty: SEPOLIA_RPC_URL.
# Secret if it contains an API key.
E2E_PAYMENT_RPC_URL=
# Optional pin of the deployment_id (0x and 64 hex digits).
E2E_DEPLOYMENT_ID=
# Optional private admin access for step 15 (both or neither). The token is GATEWAY_ADMIN_TOKEN.
E2E_ADMIN_URL=
# Prover build: auto (threaded if the page is cross-origin isolated), scalar, or threaded.
E2E_PROVER_MODE=auto
# Fixed public address for eth_getBalance. It is not the payer.
E2E_TEST_ADDRESS=0x000000000000000000000000000000000000dead
# Result file. Empty: examples/e2e/results/sepolia-result.json.
E2E_RESULT_PATH=
# Overall timeout of the example run, in seconds. Default: two hours.
E2E_TIMEOUT_SECONDS=7200
# Development ports.
E2E_PAGE_PORT=5173
DASHBOARD_PORT=5174

# --- Service launcher (tooling/dev/run-services.sh) --------------------------
# Run directory for logs and process IDs. Empty: data/run/<UTC time> and data/run/latest.
RUN_DIR=
# release (default) or debug.
SERVICES_PROFILE=release
# Seconds to wait for each health check.
HEALTH_TIMEOUT_SECONDS=120
